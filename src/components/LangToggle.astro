---
interface Props {
  currentLocale: string;
}
const { currentLocale } = Astro.props;
const isPt = currentLocale !== 'en';
---
<nav aria-label="Selecionar idioma / Language" class="flex items-center gap-1 text-sm font-medium">
  <a
    href="/"
    aria-current={isPt ? 'true' : undefined}
    class:list={[
      'px-1.5 py-0.5 transition-colors',
      isPt
        ? 'gradient-text underline decoration-2 underline-offset-4'
        : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]',
    ]}
  >
    PT
  </a>
  <span class="text-[var(--color-border-strong)]">|</span>
  <a
    href="/en/"
    aria-current={!isPt ? 'true' : undefined}
    class:list={[
      'px-1.5 py-0.5 transition-colors',
      !isPt
        ? 'gradient-text underline decoration-2 underline-offset-4'
        : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]',
    ]}
  >
    EN
  </a>
</nav>
