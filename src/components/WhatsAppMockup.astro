---
interface Props {
  locale?: string;
}
const { locale = 'pt-br' } = Astro.props;
const isEn = locale === 'en';

const msgs = isEn ? {
  badge: '24h SERVICE',
  agentName: 'Dental Clinic',
  m1: 'Hi, do you see patients tomorrow?',
  m2: 'Hi! Yes, we have available slots. Can I schedule an appointment for you? 😊',
  m3: 'Yes please! Is 2pm available?',
  m4: 'Perfect! Appointment set for tomorrow at 2pm. You\'ll receive a reminder here on the day of your visit ✅',
} : {
  badge: 'ATENDIMENTO 24h',
  agentName: 'Clínica Dental',
  m1: 'Oi, vocês atendem amanhã?',
  m2: 'Oi! Sim, temos horários disponíveis. Posso agendar uma consulta pra você? 😊',
  m3: 'Quero! Tem horário às 14h?',
  m4: 'Perfeito! Agendei pra amanhã às 14h. Você vai receber um lembrete por aqui no dia da consulta ✅',
};
---

<div class="relative flex justify-center items-start">
  <!-- Badge 24h -->
  <div
    class="absolute -top-3 -right-3 z-10 text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full text-white"
    style="background: var(--color-brand-gradient); box-shadow: 0 0 20px var(--color-glow-purple);"
  >
    {msgs.badge}
  </div>

  <!-- Phone frame -->
  <div
    class="relative w-[280px] rounded-[2.5rem] overflow-hidden shadow-2xl"
    style="background: #1a1a2e; border: 2px solid rgba(255,255,255,0.12); box-shadow: 0 32px 80px rgba(0,0,0,0.5), 0 0 60px var(--color-glow-cyan);"
  >
    <!-- Status bar -->
    <div class="flex items-center justify-between px-6 pt-3 pb-1 bg-[#128C7E]">
      <span class="text-white text-xs font-medium">9:41</span>
      <div class="flex gap-1 items-center">
        <svg width="12" height="8" viewBox="0 0 12 8" fill="white" opacity="0.9">
          <rect x="0" y="4" width="2" height="4" rx="0.5"/>
          <rect x="3" y="2.5" width="2" height="5.5" rx="0.5"/>
          <rect x="6" y="1" width="2" height="7" rx="0.5"/>
          <rect x="9" y="0" width="2" height="8" rx="0.5"/>
        </svg>
        <svg width="14" height="10" viewBox="0 0 14 10" fill="white" opacity="0.9">
          <path d="M7 2C9.5 2 11.7 3.2 13 5L14 3.8C12.4 1.9 9.8 0.5 7 0.5C4.2 0.5 1.6 1.9 0 3.8L1 5C2.3 3.2 4.5 2 7 2Z"/>
          <path d="M7 5C8.5 5 9.8 5.7 10.6 6.8L11.6 5.6C10.5 4.3 8.8 3.5 7 3.5C5.2 3.5 3.5 4.3 2.4 5.6L3.4 6.8C4.2 5.7 5.5 5 7 5Z"/>
          <circle cx="7" cy="9" r="1.2"/>
        </svg>
      </div>
    </div>

    <!-- WhatsApp header bar -->
    <div class="flex items-center gap-3 px-4 py-3 bg-[#128C7E]">
      <!-- Avatar -->
      <div
        class="w-10 h-10 rounded-full flex items-center justify-center text-white font-bold text-sm shrink-0"
        style="background: var(--color-brand-gradient);"
      >
        CD
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-white text-sm font-semibold leading-tight">{msgs.agentName}</p>
        <p class="text-emerald-200 text-xs">online</p>
      </div>
      <!-- Icons -->
      <div class="flex gap-3 text-white opacity-80">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
        </svg>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/>
        </svg>
      </div>
    </div>

    <!-- Chat area -->
    <div
      class="relative overflow-hidden px-3 py-4 space-y-3 min-h-[360px]"
      style="background: #0d1117;"
    >
      <!-- Subtle pattern background -->
      <div
        class="absolute inset-0 opacity-5"
        style="background-image: radial-gradient(circle, #4FC3F7 1px, transparent 1px); background-size: 20px 20px;"
      ></div>

      <!-- Message 1: patient -->
      <div class="relative flex justify-start mockup-msg" style="animation: fadeInUp 0.4s ease forwards; animation-delay: 0.5s; opacity: 0;">
        <div class="max-w-[80%] rounded-2xl rounded-tl-sm px-3 py-2 bg-[#202c33] text-[#e9edef] text-sm leading-relaxed">
          {msgs.m1}
          <span class="block text-right text-[10px] text-[#8696a0] mt-0.5">09:41</span>
        </div>
      </div>

      <!-- Typing indicator -->
      <div class="relative flex justify-end mockup-msg" style="animation: fadeInUp 0.4s ease forwards; animation-delay: 1.2s; opacity: 0;">
        <div
          class="flex items-center gap-1 px-4 py-3 rounded-2xl rounded-tr-sm"
          style="background: #1a2646; border: 1px solid rgba(79,195,247,0.2);"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-[#4FC3F7]" style="animation: typing 1.2s ease-in-out infinite; animation-delay: 0s;"></span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#4FC3F7]" style="animation: typing 1.2s ease-in-out infinite; animation-delay: 0.2s;"></span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#4FC3F7]" style="animation: typing 1.2s ease-in-out infinite; animation-delay: 0.4s;"></span>
        </div>
      </div>

      <!-- Message 2: agent -->
      <div class="relative flex justify-end mockup-msg" style="animation: fadeInUp 0.4s ease forwards; animation-delay: 2.0s; opacity: 0;">
        <div
          class="max-w-[80%] rounded-2xl rounded-tr-sm px-3 py-2 text-sm leading-relaxed text-[#e9edef]"
          style="background: #1a2646; border: 1px solid rgba(79,195,247,0.2);"
        >
          {msgs.m2}
          <span class="block text-right text-[10px] text-[#8696a0] mt-0.5">09:41 ✓✓</span>
        </div>
      </div>

      <!-- Message 3: patient -->
      <div class="relative flex justify-start mockup-msg" style="animation: fadeInUp 0.4s ease forwards; animation-delay: 2.8s; opacity: 0;">
        <div class="max-w-[80%] rounded-2xl rounded-tl-sm px-3 py-2 bg-[#202c33] text-[#e9edef] text-sm leading-relaxed">
          {msgs.m3}
          <span class="block text-right text-[10px] text-[#8696a0] mt-0.5">09:42</span>
        </div>
      </div>

      <!-- Message 4: agent final -->
      <div class="relative flex justify-end mockup-msg" style="animation: fadeInUp 0.4s ease forwards; animation-delay: 3.6s; opacity: 0;">
        <div
          class="max-w-[80%] rounded-2xl rounded-tr-sm px-3 py-2 text-sm leading-relaxed text-[#e9edef]"
          style="background: #1a2646; border: 1px solid rgba(79,195,247,0.2);"
        >
          {msgs.m4}
          <span class="block text-right text-[10px] text-[#8696a0] mt-0.5">09:42 ✓✓</span>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="flex items-center gap-2 px-3 py-2 bg-[#1f2c34]">
      <div class="flex-1 bg-[#2a3942] rounded-full px-4 py-2 text-xs text-[#8696a0]">
        {isEn ? 'Type a message' : 'Digite uma mensagem'}
      </div>
      <div
        class="w-9 h-9 rounded-full flex items-center justify-center text-white shrink-0"
        style="background: var(--color-brand-gradient);"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M2 21l21-9L2 3v7l15 2-15 2v7z"/>
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  @media (prefers-reduced-motion: reduce) {
    .mockup-msg {
      opacity: 1 !important;
      animation: none !important;
    }
  }
</style>
