---
interface Props {
  featured?: boolean;
  class?: string;
}
const { featured = false, class: className = '' } = Astro.props;
---
<div
  class:list={[
    'rounded-2xl p-7 border transition-all duration-300 hover:-translate-y-0.5',
    featured
      ? 'card-featured shadow-lg'
      : 'bg-[var(--color-bg-card)] border-[var(--color-border-default)] hover:border-[var(--color-border-strong)] hover:shadow-[0_0_24px_var(--color-glow-cyan)]',
    className,
  ]}
>
  <slot />
</div>
