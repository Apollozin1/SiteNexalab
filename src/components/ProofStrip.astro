---
interface Props {
  items: readonly string[];
}
const { items } = Astro.props;
---
<section
  class="border-y border-[var(--color-border-subtle)]"
  style="background: var(--color-bg-elevated); padding: 1.25rem 0;"
  aria-label="Tecnologias e parceiros"
>
  <div class="mx-auto max-w-[1200px] px-6 lg:px-8">
    <div class="flex flex-wrap items-center justify-center gap-6 md:gap-10">
      {items.map((item) => (
        <span class="text-[var(--color-text-tertiary)] text-sm font-medium whitespace-nowrap">
          {item}
        </span>
      ))}
    </div>
  </div>
</section>
